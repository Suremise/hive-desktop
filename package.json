{
  "name": "hive",
  "productName": "Hive",
  "version": "0.3.0",
  "description": "Hive — a streamlined, agent-first desktop workspace for AI-assisted coding.",
  "main": "./out/main/index.js",
  "author": "Darren Marshall",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Suremise/hive-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suremise/hive-desktop.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run lint && npm run licenses && electron-vite build",
    "licenses": "node scripts/licenses.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "release": "node scripts/release.mjs",
    "lint": "oxlint --deny-warnings src tests scripts",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "smol-toml": "^1.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
